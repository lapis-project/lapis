{
	"name": "@lapis/lexat",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./nuxt.config.ts",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "NODE_OPTIONS=--max_old_space_size=8192 nuxt build --dotenv ./.env.dev.local",
		"dev": "nuxt dev --dotenv ./.env.dev.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"start": "nuxt preview --dotenv ./.env.dev.local",
		"start-test": "nuxt preview",
		"test": "node --test tests/*.test.mjs",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "pnpm --filter @lapis/backend build && nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.5",
		"@iconify-json/lucide": "^1.2.152",
		"@lapis/backend": "workspace:*",
		"@nuxt/icon": "^2.6.2",
		"@nuxt/image": "^2.2.1",
		"@nuxt/scripts": "^1.3.12",
		"@nuxt/ui": "^4.12.0",
		"@nuxtjs/color-mode": "^4.1.0",
		"@nuxtjs/i18n": "^10.5.0",
		"@nuxtjs/robots": "^7.0.2",
		"@nuxtjs/sitemap": "9.1.0",
		"@tiptap/core": "^3.33.0",
		"@tiptap/extension-character-count": "^3.33.0",
		"@tiptap/extension-image": "^3.33.0",
		"@tiptap/extension-link": "^3.33.0",
		"@tiptap/extension-table": "^3.33.0",
		"@tiptap/extension-text-align": "^3.33.0",
		"@tiptap/extension-underline": "^3.33.0",
		"@tiptap/pm": "^3.33.0",
		"@tiptap/starter-kit": "^3.33.0",
		"@tiptap/vue-3": "^3.33.0",
		"@turf/boolean-point-in-polygon": "^7.4.0",
		"@types/three": "^0.187.0",
		"@vue/devtools-api": "^8.2.1",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"chart.js": "^4.6.1",
		"fast-glob": "^3.3.3",
		"hono": "^4.13.17",
		"html2canvas-pro": "^2.6.3",
		"maplibre-gl": "^6.17.0",
		"nuxt": "catalog:",
		"nuxt-svgo": "^5.3.2",
		"pino-http": "^11.0.0",
		"reka-ui": "^2.11.0",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.187.0",
		"v-onboarding": "^2.12.4",
		"vue": "catalog:",
		"vue-chartjs": "^5.3.4",
		"vue-i18n": "catalog:",
		"vue-i18n-routing": "^1.2.0",
		"vue-router": "catalog:",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@nuxt/devtools": "^4.1.0",
		"@playwright/test": "^1.65.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.4.0",
		"dotenv": "^17.3.1",
		"dotenv-expand": "^12.0.3",
		"npm-run-all2": "catalog:",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.0.0",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vue-tsc": "^3.3.14"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}

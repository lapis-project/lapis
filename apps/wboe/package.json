{
	"name": "@lapis/wboe",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./nuxt.config.ts",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "nuxt build --dotenv ./.env.prod",
		"dev": "nuxt dev --dotenv ./.env.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate": "nuxt generate --dotenv ./.env.prod",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"preview": "nuxt preview --dotenv ./.env.prod",
		"start": "nuxt preview --dotenv ./.env.prod",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.6",
		"@iconify-json/lucide": "^1.2.152",
		"@nuxt/content": "^3.16.2",
		"@nuxt/icon": "^2.6.2",
		"@nuxt/image": "^2.2.1",
		"@nuxt/ui": "^4.12.0",
		"@nuxtjs/color-mode": "^4.1.0",
		"@nuxtjs/i18n": "^10.5.0",
		"@nuxtjs/seo": "^6.0.1",
		"@vue/devtools-api": "^8.2.1",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "^15.0.0",
		"better-sqlite3": "^13.0.3",
		"nuxt": "catalog:",
		"nuxt-svgo": "^5.3.2",
		"tailwindcss": "catalog:",
		"tailwindcss-animate": "^1.0.7",
		"vue": "catalog:"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@types/node": "^26.6.6",
		"dotenv": "^17.4.1",
		"npm-run-all2": "catalog:",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.0.0",
		"typescript": "catalog:",
		"vue-tsc": "^3.3.14"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}

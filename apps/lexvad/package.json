{
	"name": "@lapis/lexvad",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./nuxt.config.ts",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "nuxt build --dotenv ./.env.local",
		"dev": "nuxt dev --dotenv ./.env.dev.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"start": "nuxt preview --dotenv ./.env.dev.local",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.6",
		"@deck.gl/aggregation-layers": "^9.3.7",
		"@deck.gl/core": "^9.3.6",
		"@deck.gl/extensions": "^9.3.7",
		"@deck.gl/layers": "^9.3.6",
		"@fontsource-variable/inter": "^5.2.8",
		"@iconify-json/gis": "^1.2.5",
		"@lapis/backend": "workspace:*",
		"@lucide/vue": "catalog:",
		"@nuxt/image": "^2.0.0",
		"@nuxt/ui": "^4.8.1",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/i18n": "^10.5.0",
		"@pinia/nuxt": "0.11.3",
		"@tailwindcss/vite": "^4.3.1",
		"@turf/turf": "^7.3.5",
		"@unovis/vue": "^1.6.7",
		"@vue/devtools-api": "^8.1.3",
		"@vueuse/core": "^14.2.1",
		"@vueuse/nuxt": "^14.2.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cva": "1.0.0-beta.1",
		"hono": "^4.12.26",
		"maplibre-gl": "^5.24.0",
		"nuxt": "catalog:",
		"nuxt-svgo": "^4.2.6",
		"pinia": "^3.0.4",
		"reka-ui": "^2.10.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"vee-validate": "^4.15.1",
		"vue": "catalog:",
		"vue-i18n": "^11.4.8",
		"vue-i18n-routing": "^1.2.0",
		"vue-router": "^5.2.0",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@nuxt/devtools": "^3.3.1",
		"@playwright/test": "^1.61.0",
		"@types/node": "^25.9.4",
		"dotenv": "^17.4.1",
		"dotenv-expand": "^12.0.3",
		"npm-run-all2": "catalog:",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.13.0",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vue-tsc": "^3.3.5"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}

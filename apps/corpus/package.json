{
	"name": "@lapis/corpus",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./nuxt.config.ts",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "NODE_OPTIONS=--max_old_space_size=8192 nuxt build --dotenv ./.env.local",
		"dev": "nuxt dev --dotenv ./.env.dev.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"start": "nuxt preview --dotenv ./.env.dev.local",
		"types:check": "pnpm --filter @lapis/backend build && nuxt typecheck",
		"validate": "run-p format:check lint:check types:check"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.6",
		"@fontsource-variable/inter": "^5.3.0",
		"@lapis/backend": "workspace:*",
		"@lucide/vue": "catalog:",
		"@nuxt/image": "^2.1.0",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/i18n": "^10.5.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/vue-virtual": "^3.13.38",
		"@vue/devtools-api": "^8.2.1",
		"@vueuse/core": "^14.4.0",
		"@vueuse/nuxt": "^14.4.0",
		"audiomotion-analyzer": "^4.5.4",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cva": "1.0.0-beta.1",
		"hono": "^4.13.7",
		"nuxt": "catalog:",
		"nuxt-svgo": "^5.3.0",
		"reka-ui": "^2.10.4",
		"tailwind-merge": "^3.7.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"vee-validate": "^4.15.1",
		"vue": "catalog:",
		"vue-draggable-next": "^2.3.0",
		"vue-i18n": "catalog:",
		"vue-i18n-routing": "^1.2.0",
		"vue-router": "catalog:",
		"vue-sonner": "^2.0.9",
		"vue-virtual-scroller": "^3.0.5",
		"vuedraggable": "^4.1.0",
		"wavesurfer.js": "^7.12.12"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@nuxt/devtools": "^3.3.1",
		"@playwright/test": "^1.63.0",
		"@types/node": "^25.9.4",
		"dotenv": "^17.4.1",
		"dotenv-expand": "^12.0.3",
		"npm-run-all2": "catalog:",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.15.0",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vue-tsc": "^3.3.11"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config",
		"rules": {
			"at-rule-prelude-no-invalid": [
				true,
				{
					"ignoreAtRules": [
						"apply"
					]
				}
			]
		}
	}
}

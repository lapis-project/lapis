# syntax=docker/dockerfile:1

# using alpine base image to avoid `sharp` memory leaks.
# @see https://sharp.pixelplumbing.com/install#linux-memory-allocator

# base setup
FROM node:26.12.1-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
# avoid any prompts
ENV CI=true

# Node 26 does not bundle Corepack; install the version pinned in package.json.
RUN npm install --global pnpm@12.14.0

# build
FROM base AS build

WORKDIR /app
RUN chown -R node:node /app

COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm fetch

COPY --chown=node:node ./apps/backend ./apps/backend
WORKDIR /app/apps/backend
# Use the Alpine image's Node binary instead of downloading another runtime.
RUN pnpm install --frozen-lockfile --no-runtime --offline
RUN pnpm run build

# serve
FROM base AS serve

WORKDIR /app
RUN chown -R node:node /app

# Copy Command for the backend code
COPY --from=build --chown=node:node /app .

ENV NODE_ENV=production
ENV BACKEND_PORT=3000

USER node
EXPOSE $BACKEND_PORT

CMD ["node", "./apps/backend/dist/index.js"]

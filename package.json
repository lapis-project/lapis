{
	"name": "lapis",
	"description": "Monorepo for Lapis",
	"license": "MIT",
	"author": "Kilian Kukelka",
	"type": "module",
	"scripts": {
		"build:backend": "pnpm -F backend build",
		"build:corpus": "pnpm -F corpus build",
		"build:lexat": "pnpm -F lexat build",
		"build:lexvad": "pnpm -F lexvad build",
		"build:lioe": "pnpm -F lioe build",
		"build:shadcn": "pnpm -F shadcn build",
		"build:ui": "pnpm -F ui build",
		"build:wboe": "pnpm -F wboe build",
		"clean:workspace": "node ./scripts/clean-workspace.mjs",
		"clean:workspace:dry": "node ./scripts/clean-workspace.mjs --dry-run",
		"dev-test:backend": "pnpm -F backend dev-test",
		"dev:backend": "pnpm -F backend dev",
		"dev:corpus": "pnpm -F corpus dev",
		"dev:lexat": "pnpm -F lexat dev",
		"dev:lexvad": "pnpm -F lexvad dev",
		"dev:lioe": "pnpm -F lioe dev",
		"dev:wboe": "pnpm -F wboe dev",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/.nuxt/**\" --ignore-pattern \"**/.output/**\"",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/.nuxt/**\" --ignore-pattern \"**/.output/**\"",
		"start:backend": "pnpm -F backend start",
		"start:corpus": "pnpm -F corpus start",
		"start:lexat": "pnpm -F lexat start",
		"start:lexvad": "pnpm -F lexvad start",
		"start:lioe": "pnpm -F lioe start",
		"start:wboe": "pnpm -F wboe start"
	},
	"dependencies": {},
	"devDependencies": {
		"@acdh-oeaw/commitlint-config": "^3.0.0",
		"@commitlint/cli": "^20.5.0",
		"@types/node": "^25.9.4",
		"lefthook": "catalog:",
		"node-gyp": "^12.4.0",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.59.0",
		"oxlint": "catalog:",
		"stylelint": "^17.13.0",
		"typescript": "catalog:"
	},
	"commitlint": {
		"extends": "@acdh-oeaw/commitlint-config"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.19.0",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "node",
			"version": "^24.19.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}

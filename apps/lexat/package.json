{
	"name": "@lapis/lexat",
	"private": true,
	"license": "MIT",
	"type": "module",
	"main": "./nuxt.config.ts",
	"scripts": {
		"analyze": "nuxt analyze",
		"build": "NODE_OPTIONS=--max_old_space_size=8192 nuxt build --dotenv ./.env.dev.local",
		"dev": "nuxt dev --dotenv ./.env.dev.local",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:code:check": "oxlint",
		"lint:code:fix": "oxlint --fix",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:styles:check": "stylelint \"./**/*.@(css|vue)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.@(css|vue)\" --cache --fix --ignore-path ./.gitignore",
		"postinstall": "nuxt prepare",
		"preinstall": "npx only-allow pnpm",
		"start": "nuxt preview --dotenv ./.env.dev.local",
		"start-test": "nuxt preview",
		"test": "exit 0",
		"test:e2e": "playwright test",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:update-snapshots": "playwright test --update-snapshots",
		"types:check": "nuxt typecheck",
		"validate": "run-p format:check lint:check types:check test test:e2e"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.5",
		"@iconify-json/lucide": "^1.2.114",
		"@lapis/backend": "workspace:*",
		"@lucide/vue": "catalog:",
		"@nuxt/icon": "^2.4.1",
		"@nuxt/image": "^2.0.0",
		"@nuxt/scripts": "^1.3.8",
		"@nuxt/ui": "^4.11.0",
		"@nuxtjs/color-mode": "^4.0.1",
		"@nuxtjs/i18n": "^10.5.0",
		"@nuxtjs/sitemap": "8.3.0",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/vue-table": "^8.21.3",
		"@tiptap/core": "^3.27.1",
		"@tiptap/extension-character-count": "^3.27.1",
		"@tiptap/extension-image": "^3.27.1",
		"@tiptap/extension-link": "^3.27.1",
		"@tiptap/extension-table": "^3.27.1",
		"@tiptap/extension-text-align": "^3.27.1",
		"@tiptap/extension-underline": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"@tiptap/vue-3": "^3.27.1",
		"@types/three": "^0.184.1",
		"@vee-validate/zod": "^4.15.1",
		"@vue/devtools-api": "^8.1.3",
		"@vueuse/core": "^14.2.1",
		"@vueuse/nuxt": "^14.2.1",
		"chart.js": "^4.5.1",
		"fast-glob": "^3.3.3",
		"hono": "^4.12.26",
		"html2canvas-pro": "^2.0.2",
		"maplibre-gl": "^5.19.0",
		"nuxt": "catalog:",
		"nuxt-svgo": "^4.2.6",
		"pino-http": "^11.0.0",
		"reka-ui": "^2.10.0",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.184.0",
		"tw-animate-css": "^1.4.0",
		"v-onboarding": "^2.12.4",
		"valibot": "^1.2.0",
		"vaul-vue": "^0.4.1",
		"vee-validate": "^4.15.1",
		"vue": "catalog:",
		"vue-chartjs": "^5.3.3",
		"vue-i18n": "catalog:",
		"vue-i18n-routing": "^1.2.0",
		"vue-router": "catalog:",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@acdh-oeaw/stylelint-config": "^3.0.3",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@nuxt/devtools": "^3.3.1",
		"@playwright/test": "^1.61.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^25.9.4",
		"axe-core": "^4.12.1",
		"axe-playwright": "^2.2.2",
		"ci-info": "^4.4.0",
		"dotenv": "^17.3.1",
		"dotenv-expand": "^12.0.3",
		"npm-run-all2": "catalog:",
		"schema-dts": "^2.0.0",
		"stylelint": "^17.13.0",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vue-tsc": "^3.3.5"
	},
	"browserslist": {
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		],
		"production": [
			">=0.75%",
			"not dead",
			"not op_mini all"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}

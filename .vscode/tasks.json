{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Nuxt Layers",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F shadcn build && pnpm -F ui build'",
			"problemMatcher": [],
			"isBackground": false
		},
		{
			"label": "Start DB Container",
			"type": "shell",
			"command": "docker compose --env-file .env.localsetup up -d",
			"problemMatcher": [],
			"group": "build",
			"isBackground": false
		},
		{
			"label": "Seed DB",
			"type": "shell",
			"command": "until docker exec lapis-dev-database-1 pg_isready -U lapis_dev; do sleep 1; done && docker exec -i lapis-dev-database-1 psql -U lapis_dev lapis_dev < ./db/lapis_dump.sql",
			"problemMatcher": [],
			"dependsOn": "Start DB Container",
			"group": "build",
			"isBackground": false
		},
		{
			"label": "Start Backend",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F backend dev'",
			"problemMatcher": [],
			"group": "build",
			"isBackground": true
		},
		{
			"label": "Start LexAT21",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F lexat dev'",
			"problemMatcher": [],
			"group": "build",
			"isBackground": true
		},
		{
			"label": "Start Corpus",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F corpus dev'",
			"problemMatcher": [],
			"group": "build",
			"isBackground": true
		},
		{
			"label": "Start LexVAD20",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F lexvad dev'",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Start LIÖ",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F lioe dev'",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Start WBÖ",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -F wboe dev'",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Reset DB",
			"type": "shell",
			"command": "docker compose --env-file .env.localsetup down -v",
			"problemMatcher": [],
			"isBackground": true
		},
		{
			"label": "Clean workspace (node_modules + caches)",
			"type": "shell",
			"command": "bash -lc 'source ./scripts/task-env.sh && pnpm -w run clean:workspace'",
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" },
			"group": "build"
		}
	]
}
